# Скопируйте в .env и заполните. Никогда не коммитьте .env и данные пациентов.

# --- LLM: любой OpenAI-совместимый API с открытой моделью ---
# OpenRouter (по умолчанию). Llama 3.3 70B через Groq отвечает ~1 с — важно для голоса.
# Полностью Apache-2.0 альтернатива: LLM_MODEL=qwen/qwen-2.5-72b-instruct (медленнее, 5–9 с).
# LLM_PROVIDER_SORT=latency   (OpenRouter: провайдер с минимальной задержкой)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Модель для казахского языка (грамотнее на kk):
LLM_MODEL_KK=meta-llama/llama-4-maverick
LLM_API_KEY=
# Альтернативы:
#   Together:   LLM_BASE_URL=https://api.together.xyz/v1   LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
#   Свой vLLM:  LLM_BASE_URL=http://llm.internal:8000/v1  LLM_MODEL=Qwen/Qwen2.5-7B-Instruct  LLM_NO_AUTH=true
#   Ollama:     LLM_BASE_URL=http://127.0.0.1:11434/v1    LLM_MODEL=qwen2.5:7b             LLM_NO_AUTH=true
# Без ключа ассистент работает в режиме правил (все сценарии доступны).
LLM_TIMEOUT_MS=30000

# --- Сервер ---
PORT=8787
HOST=127.0.0.1
# Токен для консоли координатора и метрик (заголовок x-staff-token). Пусто = без защиты (только демо!).
STAFF_TOKEN=
# DATA_FILE=/var/lib/clarity/db.json

# --- Вход через Google (OAuth 2.0 / OpenID Connect) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: ${PUBLIC_URL}/api/auth/google/callback
PUBLIC_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Эти Google-аккаунты входят как сотрудники клиники (через запятую):
STAFF_EMAILS=
# Демо-вход без аккаунта и перемотка времени. В пилоте: DEMO_LOGIN=false
DEMO_LOGIN=true
SESSION_DAYS=14

# --- Озвучка (Piper через sherpa-onnx) ---
# Модели: node scripts/download-voices.mjs → server/models/tts
TTS_ENABLED=true
# VOICES_DIR=/data/voices
# TTS_KK_SPEAKER=
